# Copiá este archivo como .env.local y completá con tus datos reales.
# .env.local NO se sube a GitHub (ya está en .gitignore) — es solo para tu máquina.
# En Netlify, estas mismas variables se cargan desde Site settings -> Environment variables (paso 4 del DEPLOY.md).

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Gemini (Google AI Studio -> Get API key). También se puede cargar desde la
# app en Administrativo -> Usuarios y permisos -> Asistente IA, así que esta
# variable es opcional (queda como valor por defecto si la agregás).
VITE_GEMINI_API_KEY=

# Google Drive: la app actual usa una CONEXIÓN MAQUETA (visual, no hace OAuth
# real todavía) — no hace falta ninguna credencial acá. Ver nota en DEPLOY.md
# si querés conectar Drive de verdad.

# Zoho WorkDrive (adjuntos) — flujo de SPA ("Client-based Application").
# SOLO se necesita el Client ID (público). NO existe ni se usa Client Secret
# en este flujo — nunca pongas un client secret en variables VITE_*.
# Pasos para crearlo: DEPLOY.md, sección "Zoho WorkDrive (integración real)".
VITE_ZOHO_CLIENT_ID=
# Solo si tu cuenta Zoho es de otro data center (ej: https://accounts.zoho.eu)
# VITE_ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
